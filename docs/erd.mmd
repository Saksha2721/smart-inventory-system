erDiagram
  USERS ||--o{ SESSIONS : authenticates
  USERS ||--o{ WAREHOUSE_ASSIGNMENTS : assigned
  WAREHOUSES ||--o{ WAREHOUSE_ASSIGNMENTS : grants_access
  USERS ||--o{ PURCHASE_ORDER_RECEIPTS : receives
  USERS o|--o{ STOCK_TRANSACTIONS : records
  SUPPLIERS o|--o{ PRODUCTS : supplies
  SUPPLIERS ||--o{ PURCHASE_ORDERS : receives
  PRODUCTS ||--o{ INVENTORY : stocked_as
  WAREHOUSES ||--o{ INVENTORY : contains
  PRODUCTS ||--o{ STOCK_TRANSACTIONS : moved
  WAREHOUSES ||--o{ STOCK_TRANSACTIONS : occurs_at
  WAREHOUSES ||--o{ PURCHASE_ORDERS : delivered_to
  PURCHASE_ORDERS ||--o{ PURCHASE_ORDER_ITEMS : includes
  PRODUCTS ||--o{ PURCHASE_ORDER_ITEMS : ordered
  PURCHASE_ORDER_ITEMS ||--o{ PURCHASE_ORDER_RECEIPTS : has_receipts

  USERS {
    int id PK
    string name
    string email UK
    string role
    string password_hash
    boolean active
    datetime created_at
  }
  SESSIONS {
    int id PK
    int user_id FK
    string token_hash UK
    datetime expires_at
    datetime created_at
  }
  WAREHOUSE_ASSIGNMENTS {
    int user_id PK, FK
    int warehouse_id PK, FK
  }
  LOGIN_ATTEMPTS {
    string key PK
    int failures
    int locked_until
  }
  SUPPLIERS {
    int id PK
    string name
    string contact_name
    string email
    string phone
    datetime created_at
  }
  PRODUCTS {
    int id PK
    string sku UK
    string name
    string category
    string unit
    int reorder_level
    float unit_cost
    int supplier_id FK
    datetime created_at
  }
  WAREHOUSES {
    int id PK
    string name UK
    string location
    string manager
    boolean active
    datetime created_at
  }
  INVENTORY {
    int id PK
    int product_id FK
    int warehouse_id FK
    int quantity
    datetime updated_at
  }
  STOCK_TRANSACTIONS {
    int id PK
    int product_id FK
    int warehouse_id FK
    string type
    int quantity
    string reference
    string note
    int user_id FK
    datetime created_at
  }
  PURCHASE_ORDERS {
    int id PK
    int supplier_id FK
    int warehouse_id FK
    string status
    float total
    datetime created_at
  }
  PURCHASE_ORDER_ITEMS {
    int id PK
    int purchase_order_id FK
    int product_id FK
    int quantity
    float unit_cost
  }
  PURCHASE_ORDER_RECEIPTS {
    int id PK
    int purchase_order_item_id FK
    int quantity
    int received_by FK
    datetime received_at
  }
