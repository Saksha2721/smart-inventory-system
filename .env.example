VITE_API_URL=/api
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
DB_DRIVER=sqlite
DB_PATH=./server/inventory.auth-demo.db
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave DATABASE_URL empty for SQLite local development. Never commit the real Neon URL.
DATABASE_URL=
PG_POOL_MAX=5
# Use a separate migration source path when selecting a different database copy.
SQLITE_SOURCE_PATH=./server/inventory.auth-demo.db
# Optional path; reports contain counts only, not credentials or password hashes.
MIGRATION_REPORT_PATH=./server/migration-report.json
